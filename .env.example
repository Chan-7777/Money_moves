# PayPal credentials — developer.paypal.com → Apps & Credentials
# Use sandbox values for testing, live values for production
PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET=REPLACE_WITH_YOUR_PAYPAL_SECRET
PAYPAL_ENV=sandbox

# ConvertAPI — convertapi.com → Authentication → Production Token
CONVERTAPI_SECRET=REPLACE_WITH_YOUR_CONVERTAPI_SECRET

# Resend — resend.com → API Keys
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY

# Upstash Redis — upstash.com → Create Database → REST API
# Required for distributed rate limiting across Vercel edge instances.
# Without these, rate limiting falls back to in-memory (per-instance only, ineffective).
UPSTASH_REDIS_REST_URL=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_TOKEN

# Sentry — sentry.io → Project Settings → Client Keys (DSN)
# Optional. Without this, errors are logged as structured JSON to Vercel's log explorer only.
SENTRY_DSN=REPLACE_WITH_YOUR_SENTRY_DSN

# Clerk — dashboard.clerk.com → your application → API Keys
# CLERK_SECRET_KEY is required for server-side session verification on /api/free-report.
# CLERK_JWT_KEY (the JWKS Public Key, same page) enables networkless verification —
# without it, verifyToken() falls back to fetching JWKS from Clerk's API (cached 1hr).
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_CLERK_SECRET_KEY
CLERK_JWT_KEY=REPLACE_WITH_YOUR_CLERK_JWT_KEY
